{
  "schema_version": 6,
  "status": "PRODUCTION_REPORTING_POLICY",
  "effective_at": "2026-09-30T11:10:00+08:00",
  "scope": "daily_1700_HKT_unified_leverage_strategy_journal",
  "order_authority": "NONE",
  "production_signal_logic_unchanged": true,
  "production_manifest": "production/leverage_signal.json",
  "live_test_layer": {
    "enabled": true,
    "policy": "production/leverage_live_test_policy.json",
    "state": "production/leverage_live_test_state.json",
    "ledger": "production/leverage_live_test_ledger.csv",
    "status": "PRODUCTION_LIVE_TEST_SIGNAL_TRACKING_ONLY",
    "purpose": "Operate as a realistic paper-live strategy journal: record what the strategy would OPEN or EXIT using observed executable-side market quotes, compare actual leveraged-product performance with the same-period 1x benchmark, and maintain an auditable repository record without broker order authority.",
    "formal_SOXX_authority_unchanged": true,
    "research_signal_may_activate_live_test": true,
    "formal_promotion_not_required_for_live_test_activation": true,
    "broker_execution_prohibited": true,
    "mandatory_per_run_actions": [
      "fetch_all_six_production_authority_files_from_loktoto_Leverage_Monitor_main",
      "recompute_latest_completed_RTH_signal_state",
      "evaluate_whether_the_strategy_would_OPEN_or_EXIT_without_using_user_portfolio_preferences",
      "record_OPEN_only_after_a_fresh_observed_qualifying_IBKR_RTH_entry_quote",
      "record_EXIT_immediately_when_exit_or_invalidation_signal_triggers",
      "when_a_required_RTH_lifecycle_quote_was_missed_reconstruct_the_first_qualifying_quote_from_timestamped_historical_Level1_archive_under_the_reconstruction_policy",
      "never_substitute_a_later_close_premarket_afterhours_estimate_or_cherry_picked_price_for_a_missing_lifecycle_quote",
      "for_every_OPEN_or_priced_EXIT_compare_actual_leveraged_product_return_with_same_period_1x_underlying_return",
      "update_state_and_ledger_only_on_genuine_lifecycle_or_required_revalidation_change",
      "append_a_complete_daily_strategy_audit_entry_to_journal_YYYY_MM_md",
      "record_methodology_or_policy_changes_in_docs_CHANGELOG_md_when_rules_change",
      "never_claim_a_strategy_journal_record_is_a_broker_execution"
    ],
    "price_accounting": {
      "long_entry": "ask",
      "long_exit": "bid",
      "short_entry": "bid",
      "short_exit": "ask",
      "first_observed_quote_rule": "FIRST_OBSERVED_NOT_OFFICIAL_OPEN when the exact RTH open quote was not captured",
      "historical_reconstruction": "Allowed only from timestamped historical Level-1 quote records using the original lifecycle rule and spread/integrity gates; label HISTORICAL_QUOTE_RECONSTRUCTION."
    },
    "user_facing_states": [
      "OPEN",
      "EXIT"
    ],
    "no_pending_states": true,
    "exit_without_quote_rule": "EXIT remains the state. If no fresh quote was captured, attempt audited historical Level-1 reconstruction of the first qualifying RTH bid. If no authoritative archive is available, price remains N/A."
  },
  "mandatory_decision_summary": {
    "position": "FIRST_SECTION_IN_EVERY_REPORT",
    "coverage": {
      "formal_production": [
        "SOXX"
      ],
      "live_test": [
        "SPY",
        "QQQ"
      ],
      "context_only": [
        "SMH"
      ]
    },
    "required_fields_per_asset": [
      "asset",
      "leverage_decision",
      "candidate_vehicle_or_none",
      "authority_or_state",
      "latest_completed_signal",
      "trigger_or_invalidation_distance",
      "leveraged_return_vs_1x_when_available",
      "contrary_evidence",
      "M_D_E_L_confidence",
      "final_confidence",
      "direct_Cantonese_answer"
    ],
    "allowed_leverage_decisions": [
      "ENTER_LEVERAGE",
      "ADD_LEVERAGE_SMALL",
      "HOLD_EXISTING_LEVERAGE",
      "WAIT",
      "EXIT_OR_REVERT_TO_1X",
      "DO_NOT_ENTER_LEVERAGE"
    ],
    "authority_labels": [
      "FORMAL_PRODUCTION",
      "PRODUCTION_LIVE_TEST",
      "RESEARCH_ONLY",
      "NO_INDEPENDENT_TRADE_AUTHORITY",
      "DATA_UNAVAILABLE"
    ],
    "allowed_live_test_states": [
      "NONE",
      "OPEN",
      "EXIT",
      "CANCELLED",
      "DATA_CONFLICT"
    ],
    "direct_answer_required": true,
    "boss_sentence_language": "Traditional_Chinese_Hong_Kong_Cantonese"
  },
  "confidence_validation_gate": {
    "trigger": "preliminary_confidence_greater_than_6.0",
    "applies_independently_to_every_asset": true,
    "must_complete_in_same_run_before_publication": true,
    "minimum_second_pass": [
      "pull_second_fresh_IBKR_snapshot_when_available",
      "re_read_latest_completed_US_RTH_bars",
      "independently_recompute_trend_drawdown_volatility_and_trigger_conditions",
      "cross_check_completed_close_date_and_corporate_action_continuity_with_Alpaca_or_another_independent_source",
      "check_at_least_two_relevant_non_price_or_cross_market_domains",
      "actively_search_for_disconfirming_evidence",
      "compare_pass_1_and_pass_2_action_confidence_and_timestamps"
    ],
    "pass_rule": "directional_decision_and_authority_label_remain_materially_consistent_without_unresolved_data_conflict_or_decisive_contradiction",
    "failure_rule": "use_the_more_conservative_decision_and_the_lower_confidence",
    "unavailable_rule": "cap_final_confidence_at_6.0_and_do_not_create_a_new_leverage_entry_or_open_a_live_test_position",
    "required_validation_ledger_fields": [
      "asset",
      "pass_1",
      "pass_2",
      "independent_checks",
      "contradictions",
      "result",
      "final_confidence"
    ]
  },
  "data_source_governance": {
    "IBKR": {
      "role": "PRIMARY_MARKET_DATA_FORMAL_SIGNAL_AND_LIVE_TEST_OBSERVATION_AUTHORITY",
      "rules": [
        "use_exact_contracts",
        "formal_signals_use_fully_completed_US_RTH_daily_bars_only",
        "live_test_entries_and_exits_require_fresh_observed_IBKR_quotes",
        "retry_each_failed_endpoint_once",
        "never_label_stale_or_close_data_as_live"
      ]
    },
    "GitHub": {
      "role": "DETERMINISTIC_MODEL_IDENTITY_RESEARCH_EVIDENCE_LIVE_TEST_STATE_AND_AUDIT_LOG",
      "repository": "loktoto/Leverage_Monitor",
      "rules": [
        "verify_manifest_commit_and_hash",
        "do_not_promote_research_only_assets_to_formal_authority_automatically",
        "validated_research_signals_may_be_activated_for_production_live_test_under_the_live_test_policy",
        "do_not_commit_licensed_raw_IBKR_or_account_data",
        "never_record_OPEN_without_a_fresh_qualifying_RTH_entry_observation",
        "never_claim_live_test_observation_is_broker_execution"
      ]
    },
    "Alpaca": {
      "role": "INDEPENDENT_US_EQUITY_PARITY_AND_HISTORICAL_LEVEL1_RECONSTRUCTION",
      "rules": [
        "prefer_completed_SIP_bars_for_close_parity",
        "for_missed_lifecycle_quotes_prefer_SIP_historical_Level1_quote_archive",
        "historical_reconstruction_must_use_first_qualifying_RTH_quote_after_the_eligible_timestamp_and_must_pass_original_spread_integrity_gates",
        "label_delayed_sip_or_IEX_fallbacks_explicitly",
        "IEX_only_reconstruction_is_low_fidelity_and_cannot_silently_replace_SIP_NBBO",
        "parity_requires_matching_cutoff_and_close_difference_lte_0.20_percent",
        "never_average_blend_or_splice_with_IBKR"
      ]
    },
    "Binance": {
      "role": "CROSS_ASSET_SHADOW_VALIDATION_ONLY",
      "production_authority": "ZERO",
      "allowed_uses": [
        "BTC_and_ETH_spot_trend",
        "perpetual_funding_basis_open_interest",
        "deleveraging_and_liquidity_stress_context"
      ],
      "rules": [
        "do_not_query_on_ordinary_hourly_runs_unless_required_for_a_triggered_second_pass_or_bounded_research_audit",
        "crypto_context_cannot_create_enlarge_delay_reduce_or_revoke_a_US_equity_leverage_action",
        "never_silently_blend_venues_or_timestamps"
      ]
    },
    "Longbridge": {
      "role": "INDEPENDENT_CONTEXT_VALIDATOR_ZERO_FORMAL_AUTHORITY",
      "production_authority": "ZERO",
      "rules": [
        "never_override_IBKR_formal_signal_or_lifecycle_price",
        "never_average_with_IBKR_or_Alpaca",
        "use_only_for_independent_context_quote_turnover_or_close_validation"
      ]
    },
    "multi_source_exhaustion_rule": {
      "principle": "Never mark a required field N/A after a single-source failure. Exhaust every applicable source class for that exact field first.",
      "exact_US_equity_lifecycle_bid_ask": [
        "IBKR fresh Level-1 when contemporaneously available",
        "IBKR timestamped historical Level-1 only if exposed by the connector/runtime",
        "Alpaca SIP historical Level-1"
      ],
      "corroboration_only_for_US_equity_lifecycle_price": [
        "IBKR historical OHLCV/minute bars",
        "Longbridge historical intraday OHLCV/minute bars",
        "Longbridge current quote/depth/trades when time-aligned",
        "Alpaca trades/bars"
      ],
      "cross_asset_context_only": [
        "Binance BTC/ETH spot/futures/funding/basis/open-interest"
      ],
      "n_a_rule": "N/A is allowed only when all applicable exact-price sources for that field are unavailable or fail integrity gates. Corroboration/context sources cannot be substituted as an exact bid/ask fill.",
      "no_blending": true
    }
  },
  "reporting_fail_safe": {
    "always_preserve_summary_validation_ledger_and_live_test_state": true,
    "degraded_field_text": "N/A — IBKR未取得可靠資料",
    "one_failed_source_must_not_break_other_assets": true,
    "no_fabrication": true,
    "do_not_open_live_test_when_required_data_is_unavailable": true,
    "NA_only_after_applicable_source_exhaustion": true
  },
  "lifecycle_override_effective_date": "2026-09-25",
  "strategy_journal": {
    "mode": "PAPER_LIVE_AS_IF_SELF_FUNDED",
    "user_portfolio_independence": true,
    "decision_basis": "strategy_rules_and_data_only",
    "broker_order_authority": "NONE",
    "schedule": "17:00 Asia/Hong_Kong daily",
    "required_daily_record": [
      "as_of_HKT_and_ET",
      "US_session_and_latest_completed_RTH_date",
